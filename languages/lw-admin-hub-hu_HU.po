#: php/Activator.php:45
msgid "This is not an LW plugin."
msgstr "Ez nem LW bővítmény."

#: php/Activator.php:51
msgid "This plugin is not installed."
msgstr "Ez a bővítmény nincs telepítve."

#: php/Activator.php:59
msgid "You are not allowed to activate this plugin."
msgstr "Nincs jogod bekapcsolni ezt a bővítményt."

#: php/Page.php:56
#: php/Page.php:57
#: php/Page.php:131
#: build/index.js:5
msgid "LW Plugins"
msgstr "LW Plugins"

#: php/Page.php:132
msgid "The LW Plugins page files are missing. Re-install the plugin from a release ZIP."
msgstr "Hiányoznak az LW Plugins oldal fájljai. Telepítsd újra a bővítményt egy kiadási ZIP-ből."

#: php/RegistryFallback.php:29
msgid "GDPR-compliant cookie consent banner."
msgstr "GDPR-kompatibilis sütihozzájárulási sáv."

#: php/RegistryFallback.php:38
msgid "Disable WordPress features like comments."
msgstr "WordPress-funkciók kikapcsolása, például a hozzászólásoké."

#: php/RegistryFallback.php:47
msgid "Enable WordPress features: SVG uploads and more."
msgstr "WordPress-funkciók bekapcsolása: SVG-feltöltés és egyebek."

#: php/RegistryFallback.php:56
msgid "Rate limiting, bot blocking, IP bans and security headers."
msgstr "Kéréskorlátozás, botszűrés, IP-tiltás és biztonsági fejlécek."

#: php/RegistryFallback.php:65
msgid "Lightweight image optimization — auto-convert uploads to WebP via HelloImg."
msgstr "Könnyű képoptimalizálás: a feltöltések automatikus WebP-konverziója a HelloImg-gel."

#: php/RegistryFallback.php:74
msgid "Headless LMS backend: courses, lessons, access, progress and quizzes over a REST API."
msgstr "Headless LMS-háttér: kurzusok, leckék, hozzáférés, haladás és kvízek REST API-n."

#: php/RegistryFallback.php:83
msgid "Tracking pixels: Meta, GA4, Ads, GTM, TikTok, Pinterest, Bing, Reddit, Snapchat, X."
msgstr "Követőpixelek: Meta, GA4, Ads, GTM, TikTok, Pinterest, Bing, Reddit, Snapchat, X."

#: php/RegistryFallback.php:92
msgid "Malware scanner for files, the database and vulnerable software."
msgstr "Kártevőkereső a fájlokhoz, az adatbázishoz és a sérülékeny szoftverekhez."

#: php/RegistryFallback.php:101
msgid "Essential SEO features without the bloat."
msgstr "A lényeges SEO-funkciók, felesleg nélkül."

#: php/RegistryFallback.php:110
msgid "Site maintenance via AI/REST using Abilities API."
msgstr "Oldalkarbantartás AI-on és REST-en át, az Abilities API-val."

#: php/RegistryFallback.php:119
msgid "Manage WordPress translations from community repositories."
msgstr "WordPress-fordítások kezelése közösségi tárolókból."

#: php/RegistryFallback.php:128
msgid "Clean up your admin — notices sidebar & widget manager."
msgstr "Rendezett admin: értesítési oldalsáv és widgetkezelő."

